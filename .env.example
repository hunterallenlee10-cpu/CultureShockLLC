# Contact form (Resend). TODO: create a Resend account, verify the sending domain,
# then set these in Vercel → Project → Settings → Environment Variables.
RESEND_API_KEY=
CONTACT_TO_EMAIL=          # where inquiries land, e.g. the founder's inbox (TODO confirm)
CONTACT_FROM_EMAIL=        # a verified sender, e.g. "Culture Shock <inquiries@yourdomain>"

# Full-length videos (everything except the 2024 reel) live on Vercel Blob.
# Run `node scripts/upload-blob.mjs` with BLOB_READ_WRITE_TOKEN set, then paste the
# printed base URL here. Without it, case studies fall back to loops + "Watch on Instagram".
NEXT_PUBLIC_MEDIA_BLOB_BASE=
BLOB_READ_WRITE_TOKEN=

# Canonical site URL (used for OG tags, sitemap, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://cultureshock.example
